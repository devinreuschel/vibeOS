AArch64 vibeos-seqlock-odd
(* Trailing fence after the odd bump: LDADD, DMB ISH, then the copy.
   The reader loads the copy, DMB ISHLD, then rechecks seq. *)
{
0:X1=ver; 0:X2=data;
1:X1=ver; 1:X2=data;
}
 P0                 | P1              ;
 MOV W0,#1          | LDAR W3,[X1]    ;
 LDADD W0,W6,[X1]   | LDR W4,[X2]     ;
 DMB ISH            | DMB ISHLD       ;
 STR W0,[X2]        | LDR W5,[X1]     ;
exists (1:X4=1 /\ 1:X5=0)
