AArch64 vibeos-log-ring-relaxed
{
[seq]=2; [field]=1;
0:X1=seq; 0:X2=field;
1:X1=seq; 1:X2=field;
}
 P0              | P1           ;
 MOV W0,#0       | LDR W3,[X1]  ;
 STR W0,[X1]     | LDR W4,[X2]  ;
 MOV W0,#9       | LDR W5,[X1]  ;
 STR W0,[X2]     |              ;
 MOV W0,#3       |              ;
 STR W0,[X1]     |              ;
exists ((1:X3=3 /\ 1:X5=3 /\ 1:X4=1) \/ (1:X4=9 /\ 1:X5=2))
