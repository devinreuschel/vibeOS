AArch64 vibeos-asid-cas
(* Fast path CASAL of active_asid after the payload store, against a
   rollover SWPAL. herd's SWP writes the first register and returns the
   old value in the second. Seeing the new asid without the payload is
   forbidden. *)
{
[asid]=5;
0:X1=asid; 0:X2=payload;
1:X1=asid; 1:X2=payload;
}
 P0                 | P1                 ;
 MOV W0,#1          | MOV W0,#0          ;
 STR W0,[X2]        | SWPAL W0,W5,[X1]   ;
 MOV W4,#5          | LDR W6,[X2]        ;
 MOV W0,#9          |                    ;
 CASAL W4,W0,[X1]   |                    ;
exists (1:X5=9 /\ 1:X6=0)
