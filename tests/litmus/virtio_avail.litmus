AArch64 vibeos-virtio-avail
(* Descriptor store, then DMB OSHST, then the avail index store. The
   device's DMB OSHLD sits between the index load and the descriptor
   load. Seeing the new index with the old descriptor is forbidden. *)
{
0:X1=desc; 0:X2=idx;
1:X1=desc; 1:X2=idx;
}
 P0              | P1              ;
 MOV W0,#1       | LDR W3,[X2]     ;
 STR W0,[X1]     | DMB OSHLD       ;
 DMB OSHST       | LDR W4,[X1]     ;
 STR W0,[X2]     |                 ;
exists (1:X3=1 /\ 1:X4=0)
