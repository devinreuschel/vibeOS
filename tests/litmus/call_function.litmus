AArch64 vibeos-call-function
(* Two rounds. Each stores the odd count, a release fence, func and
   waiters, then the even count with STLR. The reader takes a round only
   when both counts match. A stable round whose func or waiters belong
   to another round is forbidden. *)
{
0:X1=func; 0:X2=waiters; 0:X3=round;
1:X1=func; 1:X2=waiters; 1:X3=round;
}
 P0              | P1           ;
 MOV W0,#1       | LDAR W4,[X3] ;
 STR W0,[X3]     | LDR W5,[X2]  ;
 DMB ISH         | LDR W6,[X1]  ;
 MOV W0,#1       | DMB ISHLD    ;
 STR W0,[X1]     | LDR W7,[X3]  ;
 STR W0,[X2]     |              ;
 MOV W0,#2       |              ;
 STLR W0,[X3]    |              ;
 MOV W0,#3       |              ;
 STR W0,[X3]     |              ;
 DMB ISH         |              ;
 MOV W0,#2       |              ;
 STR W0,[X1]     |              ;
 STR W0,[X2]     |              ;
 MOV W0,#4       |              ;
 STLR W0,[X3]    |              ;
exists ((1:X4=2 /\ 1:X7=2 /\ 1:X6=0) \/ (1:X4=2 /\ 1:X7=2 /\ 1:X6=2) \/ (1:X4=2 /\ 1:X7=2 /\ 1:X5=0) \/ (1:X4=2 /\ 1:X7=2 /\ 1:X5=2) \/ (1:X4=4 /\ 1:X7=4 /\ 1:X6=0) \/ (1:X4=4 /\ 1:X7=4 /\ 1:X6=1) \/ (1:X4=4 /\ 1:X7=4 /\ 1:X5=0) \/ (1:X4=4 /\ 1:X7=4 /\ 1:X5=1))
