AArch64 vibeos-call-function
{
0:X1=func; 0:X2=arg; 0:X3=acked;
1:X1=func; 1:X2=arg; 1:X3=acked;
}
 P0              | P1              ;
 MOV W0,#1       | LDAR W4,[X3]    ;
 STLR W0,[X1]    | LDR W5,[X1]     ;
 STLR W0,[X2]    | LDR W6,[X2]     ;
 STLR W0,[X3]    |                 ;
exists (1:X4=1 /\ 1:X5=0)
