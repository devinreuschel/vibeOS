AArch64 vibeos-asid-cas-relaxed
{
[asid]=5;
0:X1=asid; 0:X2=payload;
1:X1=asid; 1:X2=payload;
}
 P0                 | P1               ;
 MOV W0,#1          | MOV W0,#0        ;
 STR W0,[X2]        | SWP W0,W5,[X1]   ;
 MOV W4,#5          | LDR W6,[X2]      ;
 MOV W0,#9          |                  ;
 CAS W4,W0,[X1]     |                  ;
exists (1:X5=9 /\ 1:X6=0)
