AArch64 vibeos-dma-mb
(* should_kick: the avail index store, DMB OSH, then the avail_event
   load. The device does the same with the event and the index. Both
   loads reading the old value is forbidden. *)
{
0:X1=idx; 0:X2=event;
1:X1=idx; 1:X2=event;
}
 P0              | P1              ;
 MOV W0,#1       | MOV W0,#1       ;
 STR W0,[X1]     | STR W0,[X2]     ;
 DMB OSH         | DMB OSH         ;
 LDR W2,[X2]     | LDR W2,[X1]     ;
exists (0:X2=0 /\ 1:X2=0)
