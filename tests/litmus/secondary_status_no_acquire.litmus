AArch64 vibeos-secondary-status-no-acquire
(* secondary_status with the boot CPU's DMB ISHLD removed. Its reuse store
   may then become visible before its status load is satisfied, so the bad
   outcome is allowed. *)
{
0:X1=status; 0:X2=param;
1:X1=status; 1:X2=param;
}
 P0              | P1              ;
 LDR W3,[X2]     | LDR W4,[X1]     ;
 MOV W0,#1       | MOV W0,#2       ;
 STLR W0,[X1]    | STR W0,[X2]     ;
exists (0:X3=2 /\ 1:X4=1)
