AArch64 vibeos-seqlock
(* TickClock publish: relaxed copy store, release fence, relaxed LDADD.
   Reader accepts only a stable seq (LDAR, copy, DMB ISHLD, LDR). *)
{
0:X1=seq; 0:X2=data;
1:X1=seq; 1:X2=data;
}
 P0                 | P1              ;
 MOV W0,#1          | LDAR W3,[X1]    ;
 STR W0,[X2]        | LDR W4,[X2]     ;
 DMB ISH            | DMB ISHLD       ;
 LDADD W0,W5,[X1]   | LDR W5,[X1]     ;
exists (1:X3=1 /\ 1:X5=1 /\ 1:X4=0)
